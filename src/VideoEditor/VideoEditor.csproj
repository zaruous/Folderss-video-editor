<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <!-- Windows가 아닌 곳(CI 등)에서도 컴파일만은 되게 한다. 실행은 Windows에서만 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- NuGet 패키지 DLL(NAudio)을 빌드 출력에 복사해 zip에 함께 넣는다 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 인물 분리 엔진 버전(시험 프로젝트도 같은 버전) -->
    <OnnxRuntimeVersion>1.22.1</OnnxRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 계약 DLL은 Folderss 본체의 것을 쓰므로 zip에 넣지 않는다 (Private=false) -->
    <ProjectReference Include="..\..\contract\Folderss.PluginContract\Folderss.PluginContract.csproj" Private="false" />
    <!-- 미리 보기 소리 재생(PCM → waveOut). 순수 관리 코드 DLL 두 개 -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- 인물 마스크(사람 따내기)를 이 PC에서 돌리는 ONNX Runtime(MIT). zip에는 관리 DLL과 Windows x64 네이티브 DLL만 넣는다(아래 PackPlugin) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
    <!-- 미리 보기 도우미(별도 프로세스, FFmpeg 공유 DLL을 FFmpeg.AutoGen으로 부름): DLL을 참조하지 않고 함께 빌드만 한다. 출력은 PackPlugin이 helper\에 넣는다 -->
    <ProjectReference Include="..\VideoEditor.Helper\VideoEditor.Helper.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 기본 전환 효과 데이터(효과는 이 파일에 더하면 늘어난다) -->
    <EmbeddedResource Include="Core\transitions.json" LogicalName="VideoEditor.Core.transitions.json" />
  </ItemGroup>

  <!--
    빌드할 때마다 bin\<구성>\net8.0-windows\<AssemblyName>.zip 을 만든다:
    plugin.json + 플러그인 DLL + .deps.json + NuGet 패키지 DLL(ReferenceCopyLocalPaths, 계약 DLL은 Private=false라 빠짐).
    Folderss는 .deps.json으로 플러그인 폴더의 DLL을 찾는다.
    네이티브 DLL은 Windows x64 것만 .deps.json이 가리키는 runtimes\win-x64\native\ 그대로 넣는다(ONNX Runtime 약 12MB, zip에서 약 4.7MB —
    다른 플랫폼 것은 넣지 않는다). ONNX Runtime의 MIT 라이선스·제3자 고지는 licenses\에.
    미리 보기 도우미(VideoEditor.Helper.exe와 그 DLL·FFmpeg.AutoGen)는 helper\에 넣는다(FFmpeg DLL은 넣지 않는다 — 사용자의 FFmpeg shared 빌드를 쓴다).
  -->
  <Target Name="PackPlugin" AfterTargets="Build">
    <PropertyGroup>
      <PluginStage>$(IntermediateOutputPath)plugin-stage\</PluginStage>
      <OnnxRuntimePackage>$(NuGetPackageRoot)microsoft.ml.onnxruntime\$(OnnxRuntimeVersion)\</OnnxRuntimePackage>
      <HelperOutput>$(MSBuildThisFileDirectory)..\VideoEditor.Helper\bin\$(Configuration)\net8.0\</HelperOutput>
      <AutoGenPackage>$(NuGetPackageRoot)ffmpeg.autogen\9.0.1.1\</AutoGenPackage>
    </PropertyGroup>
    <ItemGroup>
      <PluginDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
      <PluginNative Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' AND '%(ReferenceCopyLocalPaths.AssetType)' == 'native' AND '%(ReferenceCopyLocalPaths.RuntimeIdentifier)' == 'win-x64'" />
      <PluginLicense Include="$(OnnxRuntimePackage)LICENSE;$(OnnxRuntimePackage)ThirdPartyNotices.txt" />
      <HelperFile Include="$(HelperOutput)**\*" Exclude="$(HelperOutput)**\*.pdb;$(HelperOutput)**\*.xml" />
    </ItemGroup>
    <Error Condition="'@(PluginNative)' == ''" Text="zip에 넣을 ONNX Runtime 네이티브 DLL(runtimes\win-x64\native)을 찾지 못했습니다." />
    <Error Condition="!Exists('$(HelperOutput)VideoEditor.Helper.exe')" Text="zip에 넣을 미리 보기 도우미(VideoEditor.Helper.exe)를 찾지 못했습니다: $(HelperOutput)" />
    <RemoveDir Directories="$(PluginStage)" />
    <Copy SourceFiles="plugin.json;$(TargetPath);$(ProjectDepsFilePath);@(PluginDependency)" DestinationFolder="$(PluginStage)" />
    <Copy SourceFiles="@(PluginNative)" DestinationFolder="$(PluginStage)runtimes\win-x64\native\" />
    <Copy SourceFiles="@(PluginLicense)" DestinationFiles="@(PluginLicense->'$(PluginStage)licenses\onnxruntime-%(Filename)%(Extension)')" Condition="Exists('$(OnnxRuntimePackage)LICENSE')" />
    <Copy SourceFiles="@(HelperFile)" DestinationFiles="@(HelperFile->'$(PluginStage)helper\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(AutoGenPackage)LICENSE.txt" DestinationFiles="$(PluginStage)licenses\ffmpeg-autogen-LICENSE.txt" Condition="Exists('$(AutoGenPackage)LICENSE.txt')" />
    <ZipDirectory SourceDirectory="$(PluginStage)" DestinationFile="$(OutDir)$(AssemblyName).zip" Overwrite="true" />
    <Message Importance="high" Text="Folderss 플러그인: $(OutDir)$(AssemblyName).zip" />
  </Target>

</Project>
