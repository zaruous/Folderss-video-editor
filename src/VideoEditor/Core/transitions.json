    { "id": "SliceLeft", "name": "조각 닦기 ←", "group": "조각", "xfade": "hlslice" },
    { "id": "SliceRight", "name": "조각 닦기 →", "group": "조각", "xfade": "hrslice" },
    { "id": "SliceUp", "name": "조각 닦기 ↑", "group": "조각", "xfade": "vuslice" },
    { "id": "SliceDown", "name": "조각 닦기 ↓", "group": "조각", "xfade": "vdslice" },
