    { "id": "SqueezeV", "name": "양옆으로 눌러 바뀌기", "group": "밀어내기",
      "expr": "if(lt(abs(X-W/2),W/2*P),if(eq(PLANE,0),a0(W/2+(X-W/2)/P,Y),if(eq(PLANE,1),a1(W/2+(X-W/2)/P,Y),if(eq(PLANE,2),a2(W/2+(X-W/2)/P,Y),a3(W/2+(X-W/2)/P,Y)))),B)" },

    { "id": "CircleOpen", "name": "원 열기", "group": "열고 닫기", "xfade": "circleopen" },
    { "id": "CircleClose", "name": "원 닫기", "group": "열고 닫기", "xfade": "circleclose" },
    { "id": "CircleCrop", "name": "원으로 닫고 열기", "group": "열고 닫기", "xfade": "circlecrop" },
