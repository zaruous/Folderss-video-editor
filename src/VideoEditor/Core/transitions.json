    { "id": "WindUp", "name": "바람처럼 ↑", "group": "조각", "xfade": "vuwind" },
    { "id": "WindDown", "name": "바람처럼 ↓", "group": "조각", "xfade": "vdwind" },

    { "id": "ZoomIn", "name": "확대하며 바뀌기", "group": "특수", "xfade": "zoomin" },
    { "id": "Pixelize", "name": "모자이크", "group": "특수", "xfade": "pixelize" },
    { "id": "Blur", "name": "흐리며 바뀌기", "group": "특수", "xfade": "hblur" },

    { "id": "Heart", "name": "하트", "group": "모양",
      "expr": "if(lte(pow(((X-W/2)/(H*(1-P)*(1-P)*1.6+1))^2+((H/2-Y)/(H*(1-P)*(1-P)*1.6+1)+0.15)^2-1,3)-((X-W/2)/(H*(1-P)*(1-P)*1.6+1))^2*((H/2-Y)/(H*(1-P)*(1-P)*1.6+1)+0.15)^3,0),B,A)" },
    { "id": "Flower", "name": "꽃", "group": "모양",
      "expr": "if(lt(hypot(X-W/2,Y-H/2)/H,(1-P)*(1-P)*2.4*(0.55+0.45*abs(cos(2.5*atan2(Y-H/2,X-W/2))))),B,A)" },
    { "id": "Diamond", "name": "마름모", "group": "모양",
      "expr": "if(lte(abs(X/W-0.5)+abs(Y/H-0.5),(1-P)*1.01),B,A)" },
    { "id": "Blinds", "name": "가로 블라인드", "group": "모양",
      "expr": "if(lt(mod(Y,H/8)/(H/8),1-P),B,A)" },
    { "id": "VerticalBlinds", "name": "세로 블라인드", "group": "모양",
      "expr": "if(lt(mod(X,W/10)/(W/10),1-P),B,A)" },
    { "id": "Checker", "name": "바둑판", "group": "모양",
      "expr": "if(gt(2*(1-P)-mod(floor(X/(W/8))+floor(Y/(H/4.5)),2),mod(Y,H/4.5)/(H/4.5)),B,A)" }
  ]
}
