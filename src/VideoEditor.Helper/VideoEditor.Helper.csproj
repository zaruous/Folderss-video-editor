<Project Sdk="Microsoft.NET.Sdk">

  <!--
    미리 보기 도우미: 플러그인(Folderss)과 따로 오래 떠 있는 콘솔 프로세스. FFmpeg 공유 DLL(shared 빌드)을 FFmpeg.AutoGen(MIT)으로 불러
    재생 헤드 이동·재생 때 ffmpeg.exe를 새로 띄우지 않고(이 PC에서 프로세스 시작이 약 1.5초) 같은 렌더 그래프를 그린다.
    FFmpeg가 깨진 파일에서 죽어도 이 프로세스만 끝나고 Folderss는 살아 있다(플러그인이 ffmpeg.exe 방식으로 돌아가 다시 띄운다).
    플러그인 zip의 helper\ 폴더에 들어간다(VideoEditor.csproj PackPlugin). Windows x64 실행 파일이라 Linux CI에서도 그대로 만들어진다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>VideoEditor.Helper</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 시작 시간을 줄인다(한 번 띄워 두므로 JIT 품질보다 빨리 뜨는 쪽) -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- 플러그인과 같은 메시지 형식 -->
    <Compile Include="..\VideoEditor\Media\HelperProtocol.cs" Link="HelperProtocol.cs" />
    <!-- FFmpeg 9.0 바인딩(MIT). DLL은 들어 있지 않다 — 사용자의 FFmpeg shared 빌드 폴더를 플러그인이 넘긴다 -->
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
  </ItemGroup>

</Project>
